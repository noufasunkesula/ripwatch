[Unit]
Description=RipWatch rw-agent: Agent loop: reads rw-candidates, calls Bedrock and the MCP tools
After=network-online.target
Wants=network-online.target
After=rw-mcp-tools.service
Requires=rw-mcp-tools.service

[Service]
Type=simple
User=rw
Group=rw
EnvironmentFile=/etc/rw/rw.env
WorkingDirectory=/var/lib/rw/work
# systemd does not expand variables in the executable path; the wrapper runs $RW_PYTHON -m rw.<module>.
ExecStart=/opt/rw/bin/run agent
Restart=always
RestartSec=5
MemoryMax=512M
StandardOutput=append:/var/log/rw/rw-agent.log
StandardError=inherit
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
