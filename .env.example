# RipWatch environment. Copy to `.env` (gitignored) and fill in the blanks.
# Names and defaults: docs/sprints/sprint-1.md sections 2.2 and 5. Defaults in Python live only
# in rw/common/config.py; leave a line empty to use its default.
# Never put AWS access keys here. They live only in ~/.aws/credentials (aws configure --profile ripwatch).

# ---------------------------------------------------------------- AWS account
# Profile created with `aws configure --profile ripwatch`. Fixed.
AWS_PROFILE=ripwatch
# Fixed region for everything.
AWS_REGION=us-east-1
# 12 digits: `aws sts get-caller-identity --query Account --output text`. Not secret, keep out of git.
# Used by `make backend-config` and to derive bucket names.
AWS_ACCOUNT_ID=
# Resource name prefix. Fixed.
RW_PREFIX=rw

# ---------------------------------------------------------------- Team and budgets (Terraform inputs)
# GitHub repo for the OIDC trust policy of the rw-gha role. Fixed.
GITHUB_OWNER=noufasunkesula
GITHUB_REPO=ripwatch
# Comma-separated team emails for budgets and rw-ops-alerts.
RW_TEAM_EMAILS=
# Email subscribed to rw-lifeguard-alerts. A plus-alias like name+lifeguard@gmail.com is easy to filter.
RW_LIFEGUARD_EMAIL=
# Monthly budget rw-monthly in USD. Fixed.
RW_BUDGET_USD=50
# Bedrock-only budget rw-bedrock in USD. Fixed.
RW_BEDROCK_BUDGET_USD=10
# IAM users the iam stack creates (rw-noufa is made by hand and is not listed).
RW_IAM_USERS=rw-daksh,rw-saif
# COOL AMI ID from the AWS Marketplace subscription. Sprint 2: leave empty until subscribed.
RW_COOL_AMI_ID=

# ---------------------------------------------------------------- Resource names (sprint-1.md section 5)
# Leave buckets empty to derive rw-data-<account_id> / rw-artifacts-<account_id> from AWS_ACCOUNT_ID.
RW_DATA_BUCKET=
RW_ARTIFACTS_BUCKET=
RW_TABLE_CAMERAS=rw-cameras
RW_TABLE_JOBS=rw-jobs
RW_TABLE_DETECTIONS=rw-detections
RW_TABLE_INCIDENTS=rw-incidents
RW_TABLE_TRACE=rw-agent-trace
RW_TABLE_APPROVALS=rw-approvals
# Queue URLs and topic ARN: Terraform outputs of the data and serverless stacks (Sprint 2), or
# the moto URLs printed by `make local-up`.
RW_QUEUE_JOBS_URL=
RW_QUEUE_CANDIDATES_URL=
RW_TOPIC_LIFEGUARD_ARN=
# Worker Auto Scaling group, used by the scheduler and kill-switch Lambdas.
RW_WORKER_ASG=rw-worker-asg
# SSM parameter prefix (/rw/vision/..., /rw/ocean/latest, /rw/bedrock/model_id).
RW_SSM_PREFIX=/rw
# CloudWatch metric namespace.
RW_METRIC_NAMESPACE=RipWatch

# ---------------------------------------------------------------- Runtime
# Local mode: point every boto3 client at moto server. Empty on AWS.
RW_AWS_ENDPOINT_URL=http://127.0.0.1:5000
# boto3 read timeout in seconds (Bedrock has its own 20 s).
RW_AWS_READ_TIMEOUT_S=10
# DEBUG, INFO, WARNING, ERROR.
RW_LOG_LEVEL=INFO
# Vision runtime: cool, std-arm or std-x86. Empty locally.
RW_RUNTIME=
# Heartbeat files directory (/var/run/rw on the worker; any writable folder locally).
RW_HEARTBEAT_DIR=/var/run/rw
# Ingest work dirs and the camera-sim pointer (local runs: a folder you own, e.g. ./work/state)
RW_STATE_DIR=/var/lib/rw
# fake (scripted, free) or bedrock (real calls, costs money; Sprint 2).
RW_LLM=fake
# Bedrock model. Fixed; the worker reads the live value from /rw/bedrock/model_id.
RW_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ---------------------------------------------------------------- Services
# Seconds between replayed clips per camera (rw-camera-sim).
RW_CAMERA_SIM_INTERVAL_S=10
# Assumed fps for frame folders (FrameFolderSource).
RW_FRAME_FOLDER_FPS=15
# Dashboard origin allowed by rw-api CORS (CloudFront domain, Sprint 2).
RW_ALLOWED_ORIGIN=

# ---------------------------------------------------------------- Demo beach and ocean data (Daksh)
# NOAA CO-OPS tide station. Verify at
# https://api.tidesandcurrents.noaa.gov/mdapi/prod/webapi/stations.json
RW_NOAA_STATION_ID=
# NWS forecast zone for the same beach: https://api.weather.gov/zones?type=forecast&point=<lat>,<lon>
RW_NWS_ZONE_ID=
# NWS requires a contact: RipWatch/0.1 (<team email>)
RW_NWS_USER_AGENT=

# ---------------------------------------------------------------- Data scripts
# Hugging Face token, only to run scripts/download_ripvis.py. Never commit it.
HF_TOKEN=
