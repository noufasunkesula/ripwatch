{
  "$defs": {
    "CandidateReason": {
      "enum": [
        "status_rip",
        "status_uncertain",
        "active_incident_followup"
      ],
      "title": "CandidateReason",
      "type": "string"
    },
    "Mode": {
      "enum": [
        "video",
        "burst",
        "image"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Status": {
      "enum": [
        "rip",
        "uncertain",
        "clear"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Small pointer to a VisionResult; the agent loads the full result from rw-detections.",
  "properties": {
    "active_incident_id": {
      "anyOf": [
        {
          "pattern": "^inc_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Incident Id"
    },
    "camera_id": {
      "pattern": "^cam-[0-9]{2,}$",
      "title": "Camera Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "max_confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Max Confidence",
      "type": "number"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "reason": {
      "$ref": "#/$defs/CandidateReason"
    },
    "result_id": {
      "pattern": "^res_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "swimmers_at_risk": {
      "minimum": 0,
      "title": "Swimmers At Risk",
      "type": "integer"
    },
    "trace_id": {
      "pattern": "^tr_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "trace_id",
    "camera_id",
    "mode",
    "status",
    "max_confidence",
    "swimmers_at_risk",
    "active_incident_id",
    "reason",
    "created_at"
  ],
  "title": "CandidateMessage",
  "type": "object"
}
